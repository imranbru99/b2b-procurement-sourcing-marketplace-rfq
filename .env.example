APP_NAME="Procurement Marketplace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_DEMO=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=procurement_marketplace
DB_USERNAME=imran
DB_PASSWORD=
DB_SOCKET=/tmp/mysql.sock

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@procurement.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MODULE_CACHE_TTL=3600

# Admin panel (imrandevbd/laravel-admin-panel)
ADMIN_PANEL_PREFIX=admin
ADMIN_PANEL_NAME="Technical Admin"
ADMIN_PANEL_GUARD=web

# AI Hub
AI_HUB_PROVIDER=openai
AI_HUB_FAILOVER=true
AI_HUB_UI=true
AI_HUB_PATH=ai-hub
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# AI Catalog
AI_CATALOG_ENABLED=false

# Drutogoti observability
DRUTOGOTI_ENABLED=false
DRUTOGOTI_STORAGE_DRIVER=queue
DRUTOGOTI_QUEUE_CONNECTION=redis

# Attendance Hub
ATTENDANCE_HUB_TENANT_COLUMN=tenant_id

# Reverb / broadcasting
REVERB_APP_ID=procurement-marketplace
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http

BROADCAST_CONNECTION=reverb


# Unicode PDF
UNICODE_PDF_ENGINE=native
UNICODE_PDF_DEFAULT_FONT="Noto Sans"
UNICODE_PDF_CUSTOM_FONTS=

# AI Catalog (extended)
AI_CATALOG_PROVIDER=
AI_CATALOG_MODEL=
AI_CATALOG_PRODUCT_MODEL=App\Modules\Suppliers\Catalog\Models\Product
AI_CATALOG_PRODUCT_TABLE=products

# Attendance Hub (extended)
ATTENDANCE_DEFAULT_PROVIDER=virtual
ATTENDANCE_TIMEZONE=UTC
ATTENDANCE_DEVICE_TIMEZONE=UTC

# Payment gateways (demo-ready adapters)
STRIPE_KEY=
STRIPE_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
NAGAD_MERCHANT_ID=

# Universal slug
UNIVERSAL_SLUG_SEPARATOR=-
